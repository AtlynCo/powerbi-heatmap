model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Product","Region","ProductRegion","Defect","Line","DefectLine"]

ref table Product
ref table Region
ref table ProductRegion
ref table Defect
ref table Line
ref table DefectLine
