{
  "name": "@atlyn/heatmap",
  "version": "1.0.1",
  "private": true,
  "description": "Atlyn Heatmap: a categorical analytical matrix for Power BI",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/AtlynCo/powerbi-heatmap.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "resources": "node scripts/resources.mjs",
    "prestart": "npm run resources",
    "start": "pbiviz start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "eslint": "npx eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "tsx --test tests/*.test.ts",
    "prebuild": "npm run resources",
    "build": "node scripts/package.mjs",
    "prepackage": "npm run resources",
    "package": "node scripts/package.mjs",
    "test:browser": "playwright test",
    "sample": "node scripts/create-sample.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "audit:package": "node scripts/audit-package.mjs",
    "audit:dependencies": "npm audit --omit=dev",
    "notices": "node scripts/notices.mjs",
    "validate": "npm run typecheck && npm run lint && npm test && npm run package && npm run audit:package && npm run test:browser"
  },
  "overrides": {
    "qs": "6.16.0",
    "sockjs": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "powerbi-visuals-api": "5.11.1",
    "powerbi-visuals-utils-formattingmodel": "6.0.4",
    "powerbi-visuals-utils-formattingutils": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.0",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "ajv": "6.15.0",
    "eslint": "9.39.4",
    "eslint-plugin-powerbi-visuals": "1.1.1",
    "jszip": "3.10.1",
    "powerbi-visuals-tools": "7.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
